# Copy this file to `.env` and replace the placeholder with your real connection string.

# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Optional settings for the included PostgreSQL Compose service.
# If changed, update DATABASE_URL to match. Existing database volumes retain their credentials.
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
# POSTGRES_DB=mydb

# Persistent directory for bot memories. Mount a volume here in Docker.
MEMORY_DIR="data/memory"
TEMP_FILE_DIR="data/temporary-files"
# OpenDAL service for temporary files; fs uses TEMP_FILE_DIR by default.
TEMP_FILE_STORAGE_SERVICE="fs"
# For s3, set TEMP_FILE_STORAGE_SERVICE="s3" and provide its OpenDAL options.
# TEMP_FILE_STORAGE_CONFIG='{"bucket":"my-bucket","region":"ap-northeast-1","root":"/temporary-files"}'
LOG_DIR="data/logs"

# encryption key
# `openssl rand -base64 32` 
CREDENTIALS_ENCRYPTION_KEY="YWanDERNyYF9e/gjA7a1EDj2kMENgPLcqpkSksQt1eI="

# callback uri is OAUTH_BASE_URL/oauth/callback
OAUTH_BASE_URL="http://localhost:5173"
PUBLIC_APP_URL="http://localhost:5173"

# Token for Cloudflare Tunnel
CLOUDFLARE_TOKEN=
CLOUDFLARE_TUNNEL_DOMAIN=

# OpenSandbox
OPEN_SANDBOX_DOMAIN="localhost:3000"
OPEN_SANDBOX_API_KEY="opensandbox_local"

# SearXNG
SEARXNG_URL="http://localhost:8080"
# Optional settings for the included SearXNG Compose service.
# SEARXNG_VERSION=latest
# SEARXNG_HOST=[::]
# SEARXNG_PORT=8080

# SMTP Relay Info
SMTP_RELAY_HOST="smtp.resend.com"
SMTP_RELAY_PORT="465"
SMTP_RELAY_SECURE="true"
SMTP_RELAY_USER="resend"
SMTP_RELAY_PASS="resend_api_key"
SMTP_RELAY_DOMAIN_FROM=
