# Copy this file to `.env.dev` for local development or `.env.prd` for production.
# Set environment-specific connection strings and credentials before use.

# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Optional settings for the included PostgreSQL Compose service.
# If changed, update DATABASE_URL to match. Existing database volumes retain their credentials.
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
# POSTGRES_DB=mydb

# Persistent directory for application logs.
LOG_DIR=data/logs

# Filesystem API and per-use OpenDAL configuration.
FILESYSTEM_API_URL=http://localhost:8091
FILESYSTEM_API_TOKEN=replace-with-a-strong-random-token
# MEMORY_STORAGE_SERVICE=fs
# MEMORY_STORAGE_CONFIG={"root":""}
# TEMP_FILE_STORAGE_SERVICE=fs
# TEMP_FILE_STORAGE_CONFIG={"root":""}
# For S3, set the service to s3 and configure OpenDAL options in the JSON object.
# MEMORY_STORAGE_CONFIG={"bucket":"my-bucket","region":"ap-northeast-1","root":"/"}

# encryption key
# `openssl rand -base64 32` 
CREDENTIALS_ENCRYPTION_KEY=YWanDERNyYF9e/gjA7a1EDj2kMENgPLcqpkSksQt1eI=

# callback uri is OAUTH_BASE_URL/oauth/callback
OAUTH_BASE_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Token for Cloudflare Tunnel (required by the production Docker image).
CLOUDFLARE_TOKEN=
CLOUDFLARE_TUNNEL_DOMAIN=

# Sandbox API (the API service is configured separately).
SANDBOX_API_URL=http://localhost:8090
SANDBOX_API_TOKEN=replace-with-a-strong-random-token

# SMTP Relay Info
SMTP_RELAY_HOST=smtp.resend.com
SMTP_RELAY_PORT=465
SMTP_RELAY_SECURE=true
SMTP_RELAY_USER=resend
SMTP_RELAY_PASS=resend_api_key
SMTP_RELAY_DOMAIN_FROM=
