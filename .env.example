# Copy this file to `.env` and replace the placeholder with your real connection string.

# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Persistent directory for bot memories. Mount a volume here in Docker.
MEMORY_DIR="data/memory"
LOG_DIR="data/logs"

# encryption key
# `openssl rand -base64 32` 
CREDENTIALS_ENCRYPTION_KEY="YWanDERNyYF9e/gjA7a1EDj2kMENgPLcqpkSksQt1eI="

# callback uri is OAUTH_BASE_URL/oauth/callback
OAUTH_BASE_URL="http://localhost:5173"

# Token for Cloudflare Tunnel
CLOUDFLARE_TOKEN=
CLOUDFLARE_TUNNEL_DOMAIN=

# OpenSandbox
OPEN_SANDBOX_DOMAIN="localhost:3000"
OPEN_SANDBOX_API_KEY="opensandbox_local"

# SearXNG
SEARXNG_URL="http://localhost:8080"

# SMTP Relay Info
SMTP_RELAY_HOST="smtp.resend.com"
SMTP_RELAY_PORT="465"
SMTP_RELAY_SECURE="true"
SMTP_RELAY_USER="resend"
SMTP_RELAY_PASS="resend_api_key"
SMTP_RELAY_DOMAIN_FROM=
