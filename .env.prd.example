# Copy to .env.prd and replace the required placeholders.
# URL-encode special characters in database credentials in DATABASE_URL.
POSTGRES_USER=botmanager
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=botmanager
DATABASE_URL=postgresql://botmanager:replace-with-a-strong-password@postgres:5432/botmanager
# Generate wit : openssl rand -base64 32
# This key must be BASE64
CREDENTIALS_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# Use a separate remotely managed Cloudflare Tunnel for production.
CLOUDFLARE_TOKEN=replace-with-production-tunnel-token
PUBLIC_APP_URL=https://your-production-domain.example
OAUTH_BASE_URL=https://your-production-domain.example

LOG_DIR=/app/data/logs
# Filesystem API. Configure the same token in bot_tools.
FILESYSTEM_API_URL=http://filesystem-api:8091
FILESYSTEM_API_TOKEN=replace-with-a-strong-random-token
# MEMORY_STORAGE_SERVICE=fs
# MEMORY_STORAGE_CONFIG={"root":""}
# TEMP_FILE_STORAGE_SERVICE=fs
# TEMP_FILE_STORAGE_CONFIG={"root":""}


# Optional: configure all SMTP fields to enable email verification and password reset.
# SMTP_RELAY_HOST=smtp.example.com
# SMTP_RELAY_PORT=465
# SMTP_RELAY_SECURE=true
# SMTP_RELAY_USER=replace-with-smtp-username
# SMTP_RELAY_PASS=replace-with-smtp-password
# SMTP_RELAY_DOMAIN_FROM=example.com
