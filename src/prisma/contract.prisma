// use prisma-8
enum MCPTransport {
  http = "http"
}

enum SandboxScope {
  turn = "turn"
  thread = "thread"
  adapter = "adapter"
  bot = "bot"
  all = "all"
}

enum PublicIdSlot {
  first = "first"
  second = "second"
}

enum RateLimitCriteria {
  bot = "bot"
  agent = "agent"
  provider = "provider"
}

enum MemoryConfig {
  nouse = "nouse"
  thread = "thread"
  bot = "bot"
}

enum Role {
  viewer = "viewer" // read
  editor = "editor" // read, update
  manager = "manager" // read, update, delete, manage grant
}

enum BotExecutionSource {
  direct_message = "direct_message"
  mention = "mention"
  schedule = "schedule"
}

enum BotExecutionStatus {
  running = "running"
  succeeded = "succeeded"
  failed = "failed"
  skipped = "skipped"
}

namespace aibot {
  model mixin Timestamps {
    createdAt TimestamptzString  @default(now())
    updatedAt temporal.UpdatedAt
  }

  model ResourceBase {
    id             Uuid         @id @onCreate(uuid(7))
    organizationId Uuid
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    grants         Grant[]
  }

  model mixin Resource {
    id             Uuid         @id
    resource       ResourceBase @relation(fields: [id], references: [id], onDelete: Cascade)
    name           String
    organizationId Uuid
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@index([organizationId])
    @@unique([organizationId, name])
  }

  model PrincipalBase {
    id             Uuid         @id @onCreate(uuid(7))
    organizationId Uuid
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    grants         Grant[]      @relation("grants")
  }

  model mixin Principal {
    id             Uuid          @id
    principal      PrincipalBase @relation(fields: [id], references: [id], onDelete: Cascade)
    name           String
    organizationId Uuid
    organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@index([organizationId])
    @@unique([organizationId, name])
  }

  model mixin Junction {
    id             Int          @id @default(autoincrement())
    organizationId Uuid
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@index([organizationId])
  }

  model mixin Owned {
    id             Int          @id @default(autoincrement())
    organizationId Uuid
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@index([organizationId])
  }

  model Organization {
    id                      Uuid              @id @onCreate(uuid(7))
    name                    String
    groups                  Group[]
    users                   User[]
    chatbots                ChatBot[]
    providers               Provider[]
    adapters                ChatAdapter[]
    mcpServers              McpServer[]
    agents                  AgentDefinition[]
    usage                   AgentUsage[]
    botExecutions           BotExecution[]
    rateLimits              RateLimit[]
    oauthClients            OAuthClient[]
    sandboxes               Sandbox[]
    schedules               ChatBotSchedule[]
    +Timestamps

    mfaEnabled              Boolean           @default(false)
    sessionDurationSeconds  Int               @default(2592000)
    maxLoginAttempts        Int               @default(5)
    minimumPasswordStrength Int               @default(2)
  }

  model Group {
    +Principal
    +Timestamps
  }

  model User {
    +Principal
    email         String    @unique
    passwordHash  String
    sessions      Session[]
    isAdmin       Boolean   @default(false)
    emailVerified Boolean   @default(false)
    mfaSecret     String?   @unique
    loginAttempts Int       @default(0)
    +Timestamps
  }

  model Membership {
    +Junction
    groupId Uuid
    group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
    userId  Uuid
    user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    +Timestamps
  }

  model Grant {
    +Junction
    principalId Uuid
    principal   PrincipalBase  @relation(name: "grants", fields: [principalId], references: [id], onDelete: Cascade)
    resourceId  Uuid
    resource    ResourceBase   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
    role        Role
    grantedById Uuid?
    grantedBy   PrincipalBase? @relation(fields: [grantedById], references: [id], onDelete: SetNull)
    +Timestamps
  }

  model Session {
    +Owned
    tokenHash   String            @unique
    expiresAt   TimestamptzString
    user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId      Uuid
    mfaVerified Boolean           @default(true)
    mfaAttempts Int               @default(0)

    +Timestamps

    @@index([userId])
    @@index([expiresAt])
  }

  model ChatBotPublicId {
    +Owned
    publicId  String       @unique
    slot      PublicIdSlot
    chatbotId Uuid
    chatbot   ChatBot      @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

    +Timestamps

    @@unique([chatbotId, slot])
  }

  model ChatBot {
    +Resource
    description      String?
    instruction      String
    onFailedMessage  String
    lookbackMessages Int
    memoryConfig     MemoryConfig            @default(nouse)
    isEnabled        Boolean                 @default(true)
    agent            AgentDefinition?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
    agentId          Uuid?                   @unique
    adapters         ChatBotAdapter[]
    mcpServers       ChatBotMcpServer[]
    toolSets         ChatBotToolSetContext[]
    +Timestamps
    publicIds        ChatBotPublicId[]
    usage            AgentUsage[]
    executions       BotExecution[]
  }

  model ChatAdapterPublicId {
    +Owned
    publicId  String       @unique
    slot      PublicIdSlot
    adapterId Uuid
    adapter   ChatAdapter  @relation(fields: [adapterId], references: [id], onDelete: Cascade)
    +Timestamps

    @@unique([adapterId, slot])
  }

  model ChatAdapter {
    +Resource
    platform       String
    config         Jsonb?
    authentication OAuthAuthentication?  @relation(fields: [authId], references: [id], onDelete: SetNull)
    authId         Uuid?
    +Timestamps
    chatbots       ChatBotAdapter[]
    publicIds      ChatAdapterPublicId[]
    executions     BotExecution[]

    @@index([platform])
  }

  model ChatBotAdapter {
    +Junction
    chatbot   ChatBot      @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
    chatbotId Uuid
    adapter   ChatAdapter  @relation(fields: [adapterId], references: [id], onDelete: Cascade)
    adapterId Uuid
    +Timestamps
    schedules ChatTarget[]

    @@index([adapterId])
  }

  model Provider {
    +Resource
    providerName String
    args         Jsonb?
    headers      Jsonb?
    agents       AgentDefinition[]
    +Timestamps
  }

  model AgentDefinition {
    +Resource
    provider   Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
    providerId Uuid
    modelId    String
    options    Jsonb?
    chatbots   ChatBot[]
    usage      AgentUsage[]
    executions BotExecution[]

    +Timestamps

    @@index([providerId])
  }

  model AgentUsage {
    +Owned
    agentId       Uuid?
    agent         AgentDefinition? @relation(fields: [agentId], references: [id], onDelete: SetNull)
    chatbotId     Uuid?
    chatbot       ChatBot?         @relation(fields: [chatbotId], references: [id], onDelete: SetNull)
    providerId    Uuid?
    provider      Provider?        @relation(fields: [providerId], references: [id], onDelete: SetNull)
    inputTokens   Int
    inputDetails  Jsonb
    outputTokens  Int
    outputDetails Jsonb
    toolHistory   Jsonb
    platform      String
    threadId      String
    execution     BotExecution?
    +Timestamps

    @@index([agentId])
    @@index([chatbotId])
  }

  model BotExecution {
    id             Uuid               @id @onCreate(uuid(7))
    organizationId Uuid
    organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    chatbotId      Uuid?
    chatbot        ChatBot?           @relation(fields: [chatbotId], references: [id], onDelete: SetNull)
    agentId        Uuid?
    agent          AgentDefinition?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
    adapterId      Uuid?
    adapter        ChatAdapter?       @relation(fields: [adapterId], references: [id], onDelete: SetNull)
    scheduleId     Uuid?
    schedule       ChatBotSchedule?   @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
    usageId        Int?               @unique
    usage          AgentUsage?        @relation(fields: [usageId], references: [id], onDelete: SetNull)
    source         BotExecutionSource
    status         BotExecutionStatus @default(running)
    threadId       String?
    startedAt      TimestamptzString  @default(now())
    finishedAt     TimestamptzString?
    errorCode      String?
    errorSummary   String?

    @@index([organizationId, startedAt])
    @@index([organizationId, status, startedAt])
    @@index([chatbotId, startedAt])
    @@index([scheduleId, startedAt])
  }

  model RateLimit {
    +Resource
    criteria             RateLimitCriteria
    criteriaId           Uuid?
    perThread            Boolean
    coefficient          Jsonb // JSON of { variableNameFromAgentUsage: coefficient (decimal) }
    limit                Decimal
    limitExceededMessage String
    resetOnCron          String // cron expression for when the limit should reset, e.g. "0 0 * * *" for daily reset at midnight
    timezone             String
    +Timestamps

    @@unique([criteria, criteriaId])
  }

  model McpServer {
    +Resource
    description String?
    transport   MCPTransport
    endpoint    String?
    headers     Jsonb?
    bots        ChatBotMcpServer[]
    +Timestamps
  }

  model ChatBotMcpServer {
    +Junction
    chatbot        ChatBot              @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
    chatbotId      Uuid
    mcpServer      McpServer            @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
    mcpServerId    Uuid
    authentication OAuthAuthentication? @relation(fields: [authId], references: [id], onDelete: SetNull)
    authId         Uuid?
    createdAt      TimestamptzString    @default(now())

    @@unique([chatbotId, mcpServerId, authId])
    @@index([mcpServerId])
  }

  model OAuthClient {
    +Resource
    clientId              String
    clientSecret          String?
    authorizationEndpoint String
    tokenEndpoint         String
    refreshEndpoint       String?
    revocationEndpoint    String?
    scopes                String[]
    +Timestamps
    authentications       OAuthAuthentication[]
  }

  model OAuthAuthentication {
    +Resource
    oauth        OAuthClient        @relation(fields: [oauthId], references: [id], onDelete: Cascade)
    oauthId      Uuid
    accessToken  String
    expiresAt    TimestamptzString?
    refreshToken String?
    +Timestamps

    @@index([oauthId])
  }

  model Sandbox {
    +Resource
    sandboxType       String
    envs              Jsonb?
    allowedDomainList String[]
    initCommands      String[]                    @default([])
    sandboxScope      SandboxScope
    +Timestamps
    instances         PersistentSandboxInstance[]
  }

  //           threadId  adapterId  chatbotId
  // thread    not null   not null  not null 
  // adapter       null   not null  not null 
  // bot           null       null  not null 
  // all           null       null      null  
  model PersistentSandboxInstance {
    +Owned
    instanceId String       @unique
    sandboxId  Uuid
    sandbox    Sandbox      @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
    threadId   String?
    adapterId  Uuid?
    adapter    ChatAdapter? @relation(fields: [adapterId], references: [id], onDelete: Cascade)
    chatbotId  Uuid?
    chatbot    ChatBot?     @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
    +Timestamps
  }

  model ChatBotToolSandbox {
    +Junction
    chatbotId Uuid
    chatbot   ChatBot @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
    sandboxId Uuid
    sandBox   Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
    +Timestamps

    @@unique([sandboxId, chatbotId])
    @@index([chatbotId])
  }

  model ChatBotToolSetContext {
    +Resource
    toolSetName    String
    chatbotId      Uuid
    chatbot        ChatBot @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
    toolSetContext Jsonb   @default(json`{}`)
    +Timestamps

    @@unique([toolSetName, chatbotId, toolSetContext])
    @@index([chatbotId])
  }

  model ChatBotSchedule {
    +Resource
    prompt      String
    cronParam   String
    timezone    String
    +Timestamps
    chatTargets ChatTarget[]
    executions  BotExecution[]
  }

  model ChatTarget {
    +Junction
    chatbotAdapterId Int
    chatbotAdapter   ChatBotAdapter  @relation(fields: [chatbotAdapterId], references: [id], onDelete: Cascade)
    threadId         String
    scheduleId       Uuid
    schedule         ChatBotSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
    +Timestamps

    @@unique([chatbotAdapterId, threadId, scheduleId])
  }
}
