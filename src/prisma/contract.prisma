// use prisma-8
enum MCPTransport {
  http = "http"
}

enum SandboxScope {
  turn = "turn"
  thread = "thread"
  adapter = "adapter"
  bot = "bot"
  all = "all"
}

enum PublicIdSlot {
  first = "first"
  second = "second"
}

namespace aibot {
  model User {
    id           Int                      @id @default(autoincrement())
    email        String                   @unique
    passwordHash String
    name         String?
    chatbots     Chatbot[]
    providers    Provider[]
    adapters     ChatAdapter[]
    mcpServers   McpServer[]
    sessions     Session[]
    createdAt    TimestamptzString        @default(now())
    updatedAt    temporal.UpdatedAtString
  }

  model Session {
    id        Int               @id @default(autoincrement())
    tokenHash String            @unique
    expiresAt TimestamptzString
    user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    Int
    createdAt TimestamptzString @default(now())

    @@index([userId])
    @@index([expiresAt])
  }

  model ChatBotPublicId {
    id        String            @unique
    slot      PublicIdSlot
    chatbotId Int
    chatbot   Chatbot           @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
    createdAt TimestamptzString @default(now())

    @@unique([chatbotId, slot])
  }

  model Chatbot {
    id              Int                      @id @default(autoincrement())
    name            String
    description     String?
    instruction     String
    onFailedMessage String
    isEnabled       Boolean                  @default(true)
    owner           User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    ownerId         Int
    agent           AgentDefinition?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
    agentId         Int?                     @unique
    adapters        ChatbotAdapter[]
    mcpServers      ChatBotMcpServer[]
    createdAt       TimestamptzString        @default(now())
    updatedAt       temporal.UpdatedAtString

    isDeleted       Boolean                  @default(false)
    publicIds       ChatBotPublicId[]
    usage           AgentUsage[]

    @@index([ownerId])
  }

  model ChatAdapterPublicId {
    id        String            @unique
    slot      PublicIdSlot
    adapterId Int
    adapter   ChatAdapter       @relation(fields: [adapterId], references: [id], onDelete: Cascade)
    createdAt TimestamptzString @default(now())

    @@unique([adapterId, slot])
  }

  model ChatAdapter {
    id             Int                      @id @default(autoincrement())
    name           String
    platform       String
    config         Jsonb?
    owner          User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    ownerId        Int
    authentication OAuthAuthentication?     @relation(fields: [authId], references: [id], onDelete: SetNull)
    authId         Int?
    createdAt      TimestamptzString        @default(now())
    updatedAt      temporal.UpdatedAtString

    chatbots       ChatbotAdapter[]
    publicIds      ChatAdapterPublicId[]

    @@index([ownerId])
    @@index([platform])
  }

  model ChatbotAdapter {
    chatbot   Chatbot           @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
    chatbotId Int
    adapter   ChatAdapter       @relation(fields: [adapterId], references: [id], onDelete: Cascade)
    adapterId Int
    createdAt TimestamptzString @default(now())

    @@id([chatbotId, adapterId])
    @@index([adapterId])
  }

  model Provider {
    id           Int                      @id @default(autoincrement())
    name         String
    providerName String
    args         Jsonb?
    headers      Jsonb?
    owner        User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    ownerId      Int
    agents       AgentDefinition[]
    createdAt    TimestamptzString        @default(now())
    updatedAt    temporal.UpdatedAtString

    @@index([ownerId])
    @@unique([ownerId, name])
  }

  model AgentDefinition {
    id         Int                      @id @default(autoincrement())
    name       String
    provider   Provider                 @relation(fields: [providerId], references: [id], onDelete: Restrict)
    providerId Int
    modelId    String
    options    Jsonb?
    chatbot    Chatbot?
    owner      User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    ownerId    Int
    createdAt  TimestamptzString        @default(now())
    updatedAt  temporal.UpdatedAtString
    usage      AgentUsage[]
    isDeleted  Boolean                  @default(false)

    @@index([providerId])
  }

  model AgentUsage {
    id            Int             @id @default(autoincrement())
    agentId       Int
    agent         AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)
    chatbotId     Int
    chatbot       Chatbot         @relation(fields: [chatbotId], references: [id], onDelete: Restrict)
    inputTokens   Int
    inputDetails  Jsonb
    outputTokens  Int
    outputDetails Jsonb
    toolHistory   Jsonb

    @@index([agentId])
    @@index([chatbotId])
  }

  model McpServer {
    id          Int                      @id @default(autoincrement())
    name        String
    description String?
    transport   MCPTransport
    endpoint    String?
    headers     Jsonb?
    owner       User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    ownerId     Int
    bots        ChatBotMcpServer[]
    createdAt   TimestamptzString        @default(now())
    updatedAt   temporal.UpdatedAtString

    @@index([ownerId])
  }

  model ChatBotMcpServer {
    chatbot        Chatbot              @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
    chatbotId      Int
    mcpServer      McpServer            @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
    mcpServerId    Int
    authentication OAuthAuthentication? @relation(fields: [authId], references: [id], onDelete: SetNull)
    authId         Int?
    createdAt      TimestamptzString    @default(now())

    @@id([chatbotId, mcpServerId])
    @@index([mcpServerId])
  }

  model OAuthClient {
    id                    Int                      @id @default(autoincrement())
    owner                 User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    ownerId               Int
    name                  String
    clientId              String
    clientSecret          String?
    authorizationEndpoint String
    tokenEndpoint         String
    refreshEndpoint       String?
    revocationEndpoint    String?
    scopes                String[]
    createdAt             TimestamptzString        @default(now())
    updatedAt             temporal.UpdatedAtString

    authentications       OAuthAuthentication[]

    @@index([ownerId])
  }

  model OAuthAuthentication {
    id           Int                      @id @default(autoincrement())
    owner        User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    ownerId      Int
    oauth        OAuthClient              @relation(fields: [oauthId], references: [id], onDelete: Cascade)
    oauthId      Int
    name         String
    accessToken  String
    expiresAt    TimestamptzString?
    refreshToken String?
    createdAt    TimestamptzString        @default(now())
    updatedAt    temporal.UpdatedAtString

    @@index([ownerId])
    @@index([oauthId])
  }

  model Sandbox {
    id                Int                         @id @default(autoincrement())
    sandboxType       String
    name              String
    envs              Jsonb?
    allowedDomainList String[]
    initCommands      String[]                    @default([])
    sandboxScope      SandboxScope
    owner             User                        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    ownerId           Int

    instances         PersistentSandboxInstance[]
  }

  //           threadId  adapterId  chatbotId
  // thread    not null   not null  not null 
  // adapter       null   not null  not null 
  // bot           null       null  not null 
  // all           null       null      null  
  model PersistentSandboxInstance {
    instanceId String       @id
    sandboxId  Int
    sandbox    Sandbox      @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
    threadId   String?
    adapterId  Int?
    adapter    ChatAdapter? @relation(fields: [adapterId], references: [id], onDelete: Cascade)
    chatbotId  Int?
    chatbot    Chatbot?     @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  }

  model ChatBotToolSandbox {
    chatbotId Int
    chatbot   Chatbot @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
    sandboxId Int
    sandBox   Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

    @@id([sandboxId, chatbotId])
    @@index([chatbotId])
  }

  model ChatBotToolSetContext {
    toolSetName    String
    chatbotId      Int
    chatbot        Chatbot @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
    toolSetContext Jsonb?

    @@id([toolSetName, chatbotId])
    @@index([chatbotId])
  }
}
